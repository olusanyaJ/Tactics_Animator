{
  "name": "tactics-animator",
  "version": "1.0.0",
  "private": true,
  "description": "Football tactics animation tool that turns written instructions into animated pitch graphics.",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "main": "",
  "engines": {
    "node": "^24.22.1"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json && pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "check:engine": "node apps/web/src/server/check-engine.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "type": "module"
}
